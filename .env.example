# Poem-to-Video Environment Configuration

# LLM API — Google Gemini (free API key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.5-flash-lite

# Image Generation Provider
IMAGE_PROVIDER=pollinations  # options: pollinations, huggingface, placeholder
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
# HUGGINGFACE_API_TOKEN=your_huggingface_token_here

# Enhanced Pipeline Settings
PROMPT_REFINE=True
PARALLEL_IMAGE_GEN=True
ENABLE_SEMANTIC_SEGMENTATION=True
TARGET_LANGUAGES=en,zh,ja
